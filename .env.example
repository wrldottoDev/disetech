# Copy to .env and run:  npm start
# Never commit .env — it is gitignored.

# Max submissions per IP per 10 minutes.
CONTACT_RATE_LIMIT=5

PORT=4321

# --- Mail delivery --------------------------------------------------------
# Requests are emailed to info@disetechcr.com (hardcoded default; set
# CONTACT_TO only to send somewhere else). Reply-To is the enquirer's address,
# so replying from the mailbox goes straight back to them.
#
# Set SMTP_HOST and CONTACT_FROM and delivery turns on. Leave them empty and
# every request is validated and appended to data/contact-requests.jsonl —
# never lost, just not delivered yet. A send that FAILS is also written there,
# with the reason, so no enquiry disappears because of an outage.

# SMTP_HOST=mail.disetechcr.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_FROM=web@disetechcr.com

# CONTACT_TO=info@disetechcr.com

# Port 465 connects over TLS immediately; 587 and 25 start in the clear and
# upgrade with STARTTLS, which is required — credentials are never sent over an
# unencrypted session (the one exception is a loopback host, for local testing).
